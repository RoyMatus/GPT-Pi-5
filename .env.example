# Reference only: .env is not automatically loaded.
GPT_PI_PORT=8765
# chatgpt: explicit OpenAI OAuth sign-in; offline: no sign-in or cloud requests.
GPT_PI_PROVIDER=chatgpt
# Optional: directory for host/client registration metadata (never tokens/chats).
# GPT_PI_DATA_DIR=/path/to/private/app-data
# No API key is accepted; there is no paid API fallback.
